{
  "name": "captar",
  "version": "0.5.0",
  "description": "Execution contracts, resource limits, checkpoints, and outcome verification for production jobs and backfills.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "captor": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./execution": {
      "types": "./dist/execution/index.d.ts",
      "default": "./dist/execution/index.js"
    },
    "./execution/*": {
      "types": "./dist/execution/*.d.ts",
      "default": "./dist/execution/*.js"
    }
  },
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "repository": {
    "type": "git",
    "url": "https://github.com/8dazo/captor.git",
    "directory": "packages/ts/sdk"
  },
  "homepage": "https://captar.aurat.ai",
  "bugs": { "url": "https://github.com/8dazo/captor/issues" },
  "keywords": [
    "backfills",
    "background-jobs",
    "execution",
    "resource-limits",
    "checkpoints",
    "production-safety",
    "reliability",
    "open-source"
  ],
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "bundledDependencies": ["@captar/config", "@captar/types", "@captar/utils"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../../scripts/copy-execution-runtime.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@captar/core": "workspace:*",
    "@captar/config": "workspace:*",
    "@captar/types": "workspace:*",
    "@captar/utils": "workspace:*"
  }
}
