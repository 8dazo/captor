{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm install && pnpm db:generate && pnpm --filter marketing build",
  "installCommand": "cd ../.. && pnpm install",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
